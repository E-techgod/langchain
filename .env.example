GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promotions?sslmode=disable

# Optional overrides
PROMOTION_AGENT_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=text-embedding-3-small

# Job email workflow (use your provider's app password if required)
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SSL=false
EMAIL_FROM_ADDRESS=you@example.com
EMAIL_AGENT_MODEL=openai/gpt-oss-120b
